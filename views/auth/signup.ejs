<%- include('../partials/head') %>

<body class="min-h-screen bg-[radial-gradient(circle_at_top,rgba(244,63,94,0.12),transparent_35%),linear-gradient(180deg,#fff_0%,#f8fafc_100%)] text-slate-800">
  <%- include('../partials/nav') %>

  <main class="flex min-h-[calc(100vh-80px)] items-center justify-center px-4 py-12">
    <div class="w-full max-w-2xl">
      <div class="overflow-hidden rounded-4xl border border-slate-200 bg-white shadow-[0_25px_60px_rgba(15,23,42,0.08)]">
        <div class="bg-linear-to-r from-slate-900 via-slate-800 to-rose-900 px-8 py-8 text-center text-white">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white/10 text-2xl">✦</div>
          <h1 class="text-3xl font-black tracking-tight">Create your account</h1>
          <p class="mt-2 text-slate-300">Join staybnb and discover your perfect getaway.</p>
        </div>

        <div class="px-6 py-7 sm:px-8">
          <%- include('../partials/errors') %>

          <form action="/signup" method="POST" class="space-y-5">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">First Name</label>
                <input type="text" name="firstName" value="<%= oldInput.firstName || '' %>" placeholder="First name" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100">
              </div>
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Last Name</label>
                <input type="text" name="lastName" value="<%= oldInput.lastName || '' %>" placeholder="Last name" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100">
              </div>
            </div>

            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-700">Email Address</label>
              <input type="email" name="email" value="<%= oldInput.email || '' %>" placeholder="example@gmail.com" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>

            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-700">Password</label>
              <input type="password" name="password" placeholder="Enter your password" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100">
              <p class="mt-2 text-xs text-slate-500">8+ characters with uppercase, lowercase, number and special character.</p>
            </div>

            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-700">Confirm Password</label>
              <input type="password" name="confirmPassword" placeholder="Confirm your password" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>

            <div>
              <p class="mb-3 text-sm font-semibold text-slate-700">Register as</p>
              <div class="grid grid-cols-2 gap-4">
                <label class="cursor-pointer">
                  <input type="radio" name="userType" value="guest" class="peer sr-only" <%= oldInput.userType === "guest" ? "checked" : "" %>>
                  <div class="rounded-2xl border-2 border-slate-200 p-5 text-center transition hover:border-rose-300 hover:bg-rose-50 peer-checked:border-rose-500 peer-checked:bg-rose-50 peer-checked:shadow-md">
                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-xl text-slate-500 peer-checked:bg-rose-100">🏠</div>
                    <h3 class="mt-3 text-lg font-bold text-slate-800">Guest</h3>
                    <p class="mt-1 text-xs text-slate-500">Find a place to stay</p>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="userType" value="host" class="peer sr-only" <%= oldInput.userType === "host" ? "checked" : "" %>>
                  <div class="rounded-2xl border-2 border-slate-200 p-5 text-center transition hover:border-rose-300 hover:bg-rose-50 peer-checked:border-rose-500 peer-checked:bg-rose-50 peer-checked:shadow-md">
                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-xl text-slate-500 peer-checked:bg-rose-100">🏡</div>
                    <h3 class="mt-3 text-lg font-bold text-slate-800">Host</h3>
                    <p class="mt-1 text-xs text-slate-500">List your property</p>
                  </div>
                </label>
              </div>
            </div>

            <div class="flex items-start gap-3 pt-1">
              <input type="checkbox" name="terms" id="terms" required class="mt-1 h-4 w-4 accent-rose-500">
              <label for="terms" class="cursor-pointer text-sm text-slate-600">I agree to the <span class="font-semibold text-rose-500">Terms and Conditions</span></label>
            </div>

            <button type="submit" class="w-full rounded-2xl bg-linear-to-r from-rose-500 to-red-600 px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-rose-200 transition hover:shadow-xl hover:shadow-rose-200">Create Account</button>
          </form>

          <div class="mt-7 border-t border-slate-200 pt-6 text-center">
            <p class="text-sm text-slate-500">Already have an account?</p>
            <a href="/login" class="mt-2 inline-block text-sm font-semibold text-rose-500 hover:text-rose-600">Login to your account</a>
          </div>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-slate-400">By creating an account, you agree to our terms and policies.</p>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
