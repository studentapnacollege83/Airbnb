<%- include('../partials/head') %>

<body class="bg-white text-gray-900">

  <%- include('../partials/nav') %>


  <main class="min-h-[calc(100vh-80px)] bg-gray-50 flex items-center justify-center px-4 py-12">
      
    <div class="w-full max-w-md">

      <!-- Login Card -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-[0_8px_40px_rgba(0,0,0,0.08)] overflow-hidden">

        <!-- Top Section -->
        <div class="px-8 pt-9 pb-7 border-b border-gray-100">

          <h1 class="text-2xl font-semibold text-gray-900">
            Log in or sign up
          </h1>

          <p class="text-sm text-gray-500 mt-2">
            Welcome back! Enter your details to continue.
          </p>

        </div>


        <!-- Form Section -->
        <div class="px-8 py-8">

          <%- include('../partials/errors') %>


          <form
            action="/login"
            method="POST"
            class="space-y-5"
          >

            <!-- Email -->
            <div>

              <label
                for="email"
                class="block text-sm font-semibold text-gray-800 mb-2"
              >
                Email
              </label>

              <input
                id="email"
                type="email"
                name="email"
                value="<%= oldInput.email || '' %>"
                placeholder="Enter your email"
                autocomplete="email"
                class="w-full h-12 px-4 rounded-xl border border-gray-300 bg-white text-gray-900 placeholder-gray-400 outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-100"
                required
              >

            </div>


            <!-- Password -->
            <div>

              <div class="flex items-center justify-between mb-2">

                <label
                  for="password"
                  class="text-sm font-semibold text-gray-800"
                >
                  Password
                </label>

                <a
                  href="#"
                  class="text-xs font-semibold text-gray-700 underline hover:text-red-500 transition"
                >
                  Forgot password?
                </a>

              </div>

              <input
                id="password"
                type="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                class="w-full h-12 px-4 rounded-xl border border-gray-300 bg-white text-gray-900 placeholder-gray-400 outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-100"
                required
              >

            </div>


            <!-- Login Button -->
            <button
              type="submit"
              class="w-full h-12 bg-red-500 hover:bg-red-600 active:bg-red-700 text-white rounded-xl font-semibold transition duration-200 shadow-sm"
            >
              Log in
            </button>

          </form>


          <!-- Divider -->
          <div class="flex items-center gap-4 my-7">

            <div class="h-px bg-gray-200 flex-1"></div>

            <span class="text-xs font-medium text-gray-400">
              OR
            </span>

            <div class="h-px bg-gray-200 flex-1"></div>

          </div>


          <!-- Google -->
          <button
            type="button"
            class="w-full h-12 border border-gray-300 rounded-xl flex items-center justify-center gap-3 font-semibold text-gray-800 hover:bg-gray-50 transition"
          >

            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
            >
              <path
                fill="#4285F4"
                d="M21.35 12.27c0-.71-.06-1.39-.18-2.05H12v3.88h5.24a4.48 4.48 0 01-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.22z"
              />

              <path
                fill="#34A853"
                d="M12 21.8c2.63 0 4.84-.87 6.45-2.35l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.53A9.75 9.75 0 0012 21.8z"
              />

              <path
                fill="#FBBC05"
                d="M6.54 13.89a5.87 5.87 0 010-3.78V7.58H3.3a9.8 9.8 0 000 8.84l3.24-2.53 0-2.53z"
              />

              <path
                fill="#EA4335"
                d="M12 6.08c1.43 0 2.71.49 3.72 1.45l2.79-2.79C16.83 3.2 14.63 2.2 12 2.2a9.75 9.75 0 00-8.7 5.38l3.24 2.53C7.31 7.8 9.46 6.08 12 6.08z"
              />
            </svg>

            Continue with Google

          </button>


          <!-- Signup -->
          <div class="text-center mt-7">

            <span class="text-sm text-gray-500">
              Don't have an account?
            </span>

            <a
              href="/signup"
              class="text-sm font-semibold text-red-500 hover:text-red-600 ml-1"
            >
              Sign up
            </a>

          </div>

        </div>

      </div>


      <!-- Footer -->
      <p class="text-center text-xs text-gray-400 mt-6 px-6">
        By continuing, you agree to our
        <span class="underline">Terms of Service</span>
        and
        <span class="underline">Privacy Policy</span>.
      </p>

    </div>

  </main>

</body>

</html>