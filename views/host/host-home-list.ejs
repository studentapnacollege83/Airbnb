<%- include('../partials/head') %>

<body class="bg-stone-50 text-slate-800">
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="mb-10 flex flex-col gap-4 rounded-[30px] bg-gradient-to-r from-slate-900 via-slate-800 to-rose-900 px-6 py-10 text-white shadow-[0_25px_60px_rgba(15,23,42,0.25)] sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-rose-300">Host dashboard</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">Your hosted homes</h1>
      </div>
      <a href="/host/add-home" class="inline-flex rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-slate-900 transition hover:bg-slate-100">Add new home</a>
    </section>

    <% if (registeredHomes.length === 0) { %>
      <div class="rounded-[28px] border border-dashed border-slate-300 bg-white px-6 py-16 text-center text-slate-500 shadow-sm">You have not added any homes yet.</div>
    <% } else { %>
      <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 xl:grid-cols-3">
        <% registeredHomes.forEach(home => { %>
          <article class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_15px_35px_rgba(15,23,42,0.06)]">
            <img src="<%= imageUrl(home.photo) %>" alt="<%= home.houseName %>" class="h-60 w-full object-cover">

            <div class="p-5">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-xl font-black text-slate-900"><%= home.houseName %></h3>
                <div class="flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-1 text-amber-600">
                  <span>★</span>
                  <span class="text-sm font-semibold text-slate-700"><%= home.rating %></span>
                </div>
              </div>

              <p class="mt-2 flex items-center gap-2 text-sm text-slate-500"><span class="text-rose-500">●</span><%= home.location %></p>
              <p class="mt-4 text-xl font-black text-slate-900">₹<%= home.price %> <span class="text-sm font-medium text-slate-500">/ night</span></p>

              <div class="mt-5 flex gap-2">
                <a href="/host/edit-home/<%= home._id %>" class="flex-1 rounded-full bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-rose-500">Edit</a>
                <form action="/host/delete-home/<%= home._id %>" method="POST" class="flex-1">
                  <button type="submit" class="w-full rounded-full border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-600 transition hover:bg-rose-100">Delete</button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
