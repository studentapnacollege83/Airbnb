<div class="mt-4">

  <form
    action="/favourites"
    method="POST"
  >

    <input
      type="hidden"
      name="homeId"
      value="<%= home._id %>"
    >

    <button
      type="submit"
      class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-rose-500 to-red-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-rose-200 transition hover:shadow-xl hover:shadow-rose-200"
    >
      <span>♥</span>
      Add to favourites
    </button>

  </form>

</div>