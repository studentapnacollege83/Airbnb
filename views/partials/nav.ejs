<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/80 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-br from-rose-500 to-red-600 shadow-lg shadow-rose-200 transition hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c-3.5 0-6.2 3.1-6.2 6.8 0 2.4 1.2 4.4 2.7 6.2L12 21l3.5-5c1.5-1.8 2.7-3.8 2.7-6.2C18.2 6.1 15.5 3 12 3z" />
        </svg>
      </div>
      <span class="text-2xl font-black tracking-tight text-slate-900">stay<span class="text-rose-500">bnb</span></span>
    </a>

    <div class="hidden items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-2 py-2 shadow-sm md:flex">
      <span class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-white">Stays</span>
      <span class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-white">Experiences</span>
      <span class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-white">Host</span>
    </div>

    <ul class="flex items-center justify-end gap-2 sm:gap-3">
      <% if (isLoggedIn) { %>
        <% if (!user || user.userType !== "host") { %>
          <li><a href="/" class="rounded-full px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100">Home</a></li>
          <li><a href="/favourites" class="rounded-full px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100">Favourites</a></li>
          <li><a href="/homes" class="hidden rounded-full px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 sm:inline-block">Browse</a></li>
        <% } else if (user && user.userType === "host") { %>
          <li><a href="/host/add-home" class="rounded-full px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100">Add Home</a></li>
          <li><a href="/host/host-home-list" class="rounded-full px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100">My Homes</a></li>
        <% } %>

        <li>
          <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-2 py-1.5 shadow-sm">
            <span class="hidden text-sm font-semibold text-slate-700 sm:inline-block">Account</span>
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 21a8 8 0 00-16 0M12 13a4 4 0 100-8 4 4 0 000 8z" />
              </svg>
            </span>
          </div>
        </li>

        <li>
          <form action="/logout" method="POST">
            <button type="submit" class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-rose-200 hover:text-rose-500">Logout</button>
          </form>
        </li>

      <% } else { %>
        <li>
          <a href="/host/add-home" class="hidden rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 sm:inline-block">Airbnb your home</a>
        </li>
        <li><a href="/signup" class="rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">Sign up</a></li>
        <li><a href="/login" class="rounded-full bg-gradient-to-r from-rose-500 to-red-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-rose-200 transition hover:shadow-xl hover:shadow-rose-200">Log in</a></li>
      <% } %>
    </ul>
  </nav>
</header>
