<%- include('../partials/head') %>

<body class="bg-stone-50 text-slate-800">
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-[0_25px_60px_rgba(15,23,42,0.08)]">
      <img src="<%= imageUrl(home.photo) %>" alt="<%= home.houseName %>" class="h-105 w-full object-cover">

      <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-rose-50 px-3 py-1 text-sm font-semibold text-rose-600">Featured stay</span>
            <span class="flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-sm font-semibold text-amber-700"><span>★</span><%= home.rating %></span>
          </div>

          <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl"><%= home.houseName %></h1>

          <div class="mt-5 space-y-4 text-slate-700">
            <p class="flex items-center gap-2 text-lg"><span class="text-rose-500">📍</span><span class="font-medium"><%= home.location %></span></p>
            <p class="text-lg"><span class="font-semibold text-slate-900">Price:</span> ₹<%= home.price %> / night</p>
          </div>

          <div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="text-xl font-black text-slate-900">Description</h3>
            <p class="mt-3 leading-7 text-slate-600"><%= home.description %></p>
          </div>
        </div>

        <aside class="rounded-[28px] border border-slate-200 bg-slate-50 p-5 shadow-sm">
          <h3 class="text-xl font-black text-slate-900">Reserve your stay</h3>
          <p class="mt-3 text-sm text-slate-500">Book with confidence and enjoy a premium experience.</p>

          <div class="mt-6 space-y-4">
            <div class="rounded-2xl bg-white p-4 shadow-sm">
              <p class="text-sm text-slate-500">From</p>
              <p class="mt-1 text-3xl font-black text-slate-900">₹<%= home.price %></p>
              <p class="text-sm text-slate-500">per night</p>
            </div>

            <%- include('../partials/favourite') %>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
