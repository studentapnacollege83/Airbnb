<%- include('../partials/head') %>

<body class="min-h-screen bg-stone-50 text-slate-800">
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="relative mb-12 overflow-hidden rounded-[32px] bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.18),_transparent_35%),linear-gradient(135deg,#111827_0%,#1f2937_35%,#0f172a_100%)] px-6 py-12 shadow-[0_30px_80px_rgba(15,23,42,0.25)] sm:px-10 lg:px-12">
      <div class="relative max-w-2xl">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.22em] text-rose-300">Find your next stay</p>
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">Feel at home, anywhere you go.</h1>
        <p class="mt-4 max-w-xl text-base leading-7 text-slate-300 sm:text-lg">Discover beautifully curated spaces for slow mornings, city escapes, and unforgettable stays that feel like your own.</p>
        <div class="mt-7 flex flex-wrap gap-4">
          <a href="/homes" class="inline-flex rounded-full bg-rose-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-rose-500/30 transition hover:bg-rose-400">Explore homes</a>
          <a href="/signup" class="inline-flex rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Become a host</a>
        </div>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
          <p class="text-3xl font-black text-white">1.2k+</p>
          <p class="mt-1 text-sm text-slate-300">Verified homes</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
          <p class="text-3xl font-black text-white">4.9/5</p>
          <p class="mt-1 text-sm text-slate-300">Guest rating</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
          <p class="text-3xl font-black text-white">24/7</p>
          <p class="mt-1 text-sm text-slate-300">Support team</p>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <div class="mb-7 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-rose-500">Featured stays</p>
          <h2 class="mt-1 text-3xl font-black tracking-tight text-slate-900">Homes guests love</h2>
        </div>
        <a href="/homes" class="hidden text-sm font-semibold text-slate-700 transition hover:text-rose-500 sm:block">View all homes →</a>
      </div>

      <% if (registeredHomes.length === 0) { %>
        <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center text-slate-500 shadow-sm">No homes are available yet. Please check back soon.</div>
      <% } else { %>
        <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 xl:grid-cols-3">
          <% registeredHomes.forEach(home => { %>
            <article class="group overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_15px_35px_rgba(15,23,42,0.06)] transition duration-300 hover:-translate-y-2 hover:shadow-[0_30px_60px_rgba(15,23,42,0.12)]">
              <div class="overflow-hidden">
                <img src="<%= imageUrl(home.photo) %>" alt="<%= home.houseName %>" class="h-60 w-full object-cover transition duration-500 group-hover:scale-105">
              </div>

              <div class="p-5">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-xl font-black text-slate-900"><%= home.houseName %></h3>
                  <div class="flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-1 text-amber-600">
                    <span>★</span>
                    <span class="text-sm font-semibold text-slate-700"><%= home.rating %></span>
                  </div>
                </div>

                <p class="mt-2 flex items-center gap-2 text-sm text-slate-500"><span class="text-rose-500">●</span><%= home.location %></p>

                <div class="mt-5 flex items-center justify-between">
                  <span class="text-xl font-black text-slate-900">₹<%= home.price %> <span class="text-sm font-medium text-slate-500">/ night</span></span>
                  <a href="/homes/<%= home._id %>" class="rounded-full bg-slate-900 px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-rose-500">View stay</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
