<%- include('../partials/head') %>

<body class="bg-stone-50 text-slate-800">
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="mb-10 rounded-[30px] bg-linear-to-r from-slate-900 via-slate-800 to-rose-900 px-6 py-10 text-white shadow-[0_25px_60px_rgba(15,23,42,0.2)] sm:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-rose-300">Curated stays</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">Available homes</h1>
      <p class="mt-2 max-w-2xl text-slate-300">Choose from handpicked homes that combine comfort, style, and unbeatable locations.</p>
    </section>

    <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 xl:grid-cols-3">
      <% registeredHomes.forEach(home => { %>
        <article class="group overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_15px_35px_rgba(15,23,42,0.06)] transition hover:-translate-y-1 hover:shadow-[0_30px_60px_rgba(15,23,42,0.12)]">
          <div class="overflow-hidden">
            <img src="<%= imageUrl(home.photo) %>" alt="<%= home.houseName %>" class="h-60 w-full object-cover transition duration-500 group-hover:scale-105">
          </div>

          <div class="p-5">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-xl font-black text-slate-900"><%= home.houseName %></h3>
              <div class="flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-1 text-amber-600">
                <span>★</span>
                <span class="text-sm font-semibold text-slate-700"><%= home.rating %></span>
              </div>
            </div>

            <p class="mt-2 flex items-center gap-2 text-sm text-slate-500"><span class="text-rose-500">●</span><%= home.location %></p>

            <div class="mt-5 flex items-center justify-between">
              <span class="text-xl font-black text-slate-900">₹<%= home.price %> <span class="text-sm font-medium text-slate-500">/ night</span></span>
              <a href="/homes/<%= home._id %>" class="rounded-full bg-slate-900 px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-rose-500">View details</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
